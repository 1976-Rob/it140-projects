# Project One Move-Between-Rooms Pseudocode
#
# Graded checkpoint: Module Five Project One
# Later use: conceptual support for M6; movement design for M7
#
# Review the course-provided movement flowchart before completing this file.
# Write pseudocode, not Python code. Use clear indentation and course-appropriate
# keywords such as INPUT, OUTPUT, IF, ELSE, WHILE, SET, or similar terms.

FUNCTION move_player(current_room, direction)

    IF current_room == "Docking Bay" THEN
        IF direction == "north" THEN
            current_room = "Command Center"
        ELSE IF direction == "east" THEN
            current_room = "Engineering Lab"
        ELSE IF direction == "west" THEN
            current_room = "Medical Bay"
        ELSE
            DISPLAY "You can't go that way."
        END IF

    ELSE IF current_room == "Command Center" THEN
        IF direction == "south" THEN
            current_room = "Docking Bay"
        ELSE
            DISPLAY "You can't go that way."
        END IF

    ELSE IF current_room == "Engineering Lab" THEN
        IF direction == "west" THEN
            current_room = "Docking Bay"
        ELSE IF direction == "south" THEN
            current_room = "Storage Room"
        ELSE
            DISPLAY "You can't go that way."
        END IF

    ELSE IF current_room == "Storage Room" THEN
        IF direction == "north" THEN
            current_room = "Engineering Lab"
        ELSE IF direction == "south" THEN
            current_room = "Research Lab"
        ELSE
            DISPLAY "You can't go that way."
        END IF

    ELSE IF current_room == "Research Lab" THEN
        IF direction == "north" THEN
            current_room = "Storage Room"
        ELSE IF direction == "west" THEN
            current_room = "Security Office"
        ELSE IF direction == "south" THEN
            current_room = "AI Core"
        ELSE
            DISPLAY "You can't go that way."
        END IF

    ELSE IF current_room == "Medical Bay" THEN
        IF direction == "east" THEN
            current_room = "Docking Bay"
        ELSE IF direction == "south" THEN
            current_room = "Crew Quarters"
        ELSE
            DISPLAY "You can't go that way."
        END IF

    ELSE IF current_room == "Crew Quarters" THEN
        IF direction == "north" THEN
            current_room = "Medical Bay"
        ELSE IF direction == "south" THEN
            current_room = "Security Office"
        ELSE
            DISPLAY "You can't go that way."
        END IF

    ELSE IF current_room == "Security Office" THEN
        IF direction == "north" THEN
            current_room = "Crew Quarters"
        ELSE IF direction == "east" THEN
            current_room = "Research Lab"
        ELSE
            DISPLAY "You can't go that way."
        END IF

    ELSE IF current_room == "AI Core" THEN
        IF direction == "north" THEN
            current_room = "Research Lab"
        ELSE
            DISPLAY "You can't go that way."
        END IF
    END IF

    RETURN current_room

END FUNCTION
`
